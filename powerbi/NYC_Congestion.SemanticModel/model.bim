          {
            "name": "Top 10 pickup zones",
            "expression": [
              "VAR ZoneRank = RANKX(ALLSELECTED(dim_zones[zone_name]), [Zone trips], , DESC, Skip)",
              "RETURN IF(NOT ISBLANK([Zone trips]) && ZoneRank <= 10, [Zone trips])"
            ],
            "formatString": "#,0",
            "lineageTag": "f3d6193c-20ca-4c6e-b700-0c89035dc743"

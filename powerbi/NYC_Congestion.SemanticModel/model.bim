        ],
        "partitions": [
          {
            "name": "mart_toll_effect",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(SourceUrl, [RelativePath = \"mart_toll_effect.csv\"]),",
                "        [Delimiter = \",\", Columns = 13, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    EmptyAsNull = Table.TransformColumns(Headers, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"comparison\", type text}, {\"method\", type text}, {\"scope\", type text}, {\"segment\", type text}, {\"control_group\", type text}, {\"is_main_estimate\", type logical}, {\"months_compared\", Int64.Type}, {\"treated_days\", Int64.Type}, {\"baseline_days\", Int64.Type}, {\"speed_effect_pct\", type number}, {\"ci95_low_pct\", type number}, {\"ci95_high_pct\", type number}, {\"is_significant\", type logical}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Speed gain in the zone, 2025",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024\",",
              "    mart_toll_effect[scope] = \"all hours\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Peak hours, 2025",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024\",",
              "    mart_toll_effect[scope] = \"peak hours\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "2026 so far",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2026 vs 2024\",",
              "    mart_toll_effect[scope] = \"all hours\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Placebo, 2024 vs 2023",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"placebo: 2024 vs 2023\",",
              "    mart_toll_effect[scope] = \"all hours\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Effect 2025 vs 2024",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Effect 2025 with this control",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024\",",
              "    mart_toll_effect[scope] = \"all hours\"",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Trend-adjusted, 2025",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024, trend-adjusted\",",
              "    mart_toll_effect[scope] = \"all hours\"",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          }
        ]
      },

        "measures": [
          {
            "name": "Speed gain in the zone, 2025",
            "expression": [
              "CALCULATE(",
              "    AVERAGE(mart_toll_effect[speed_effect_pct]),",
              "    mart_toll_effect[segment] = \"within_zone\",",
              "    mart_toll_effect[comparison] = \"2025 vs 2024\",",
              "    mart_toll_effect[scope] = \"all hours\",",
              "    mart_toll_effect[is_main_estimate] = TRUE()",
              ")"
            ],
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "78a76ef6-6be3-4b31-8c87-16a8880299ee"
          },
          {
            "name": "Peak hours, 2025",

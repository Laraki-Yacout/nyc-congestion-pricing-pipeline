                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"month_start\", type date}, {\"zone_id\", Int64.Type}, {\"trips\", Int64.Type}, {\"distance_mi\", type number}, {\"duration_min\", type number}, {\"total_amount\", type number}, {\"cbd_fee\", type number}}, \"en-US\")",

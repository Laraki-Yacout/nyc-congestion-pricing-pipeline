        "lineageTag": "003307c2-4e9b-48dd-9ba6-2cfc710b063b",
        "measures": [
          {
            "name": "Total trips",
            "expression": "SUM(fct_trips_hourly[trips])",
            "formatString": "#,0",
            "lineageTag": "4c73b167-0ddc-4314-a431-f18fa6222edf"
          },
          {
            "name": "Revenue",
            "expression": "SUM(fct_trips_hourly[total_amount])",
            "formatString": "\"$\"#,0",
            "lineageTag": "a83d95af-0eeb-4977-aa4e-a8a8b1edbfcb"
          },
          {
            "name": "Average fare",
            "expression": "DIVIDE(SUM(fct_trips_hourly[fare_amount]), [Total trips])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "aa197b33-8db5-4c3e-9352-87e34382ab20"
          },
          {
            "name": "Average speed (mph)",
            "expression": "DIVIDE(SUM(fct_trips_hourly[distance_mi]), SUM(fct_trips_hourly[duration_min]) / 60)",
            "formatString": "0.0",
            "lineageTag": "aeb5c63c-427c-4358-a47a-08a74bdec5db"
          },
          {
            "name": "Average trip time (min)",
            "expression": "DIVIDE(SUM(fct_trips_hourly[duration_min]), [Total trips])",
            "formatString": "0.0",
            "lineageTag": "ffa75fde-301c-4d52-8e90-c83c331c4588"
          },
          {
            "name": "Congestion fees paid",
            "expression": "SUM(fct_trips_hourly[cbd_fee])",
            "formatString": "\"$\"#,0",
            "lineageTag": "5cafbd02-4892-4d33-aa9a-afdab6b2f28f"
          },
          {
            "name": "Congestion fees (since the toll)",
            "expression": [
              "VAR Fees = [Congestion fees paid]",
              "RETURN IF(Fees > 0, Fees)"
            ],
            "formatString": "\"$\"#,0",
            "lineageTag": "2bd790d8-cef3-49f0-9d1f-8db8f079bf1d"
          },
          {
            "name": "Trips vs previous year",
            "expression": [
              "VAR Previous = CALCULATE([Total trips], DATEADD(dim_date[date], -1, YEAR))",
              "RETURN DIVIDE([Total trips] - Previous, Previous)"
            ],
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "94c779ff-1213-472d-b4bc-6d217ca471d7"
          },
          {
            "name": "Data up to",
            "expression": "FORMAT(CALCULATE(MAX(fct_trips_hourly[pickup_date]), ALL(fct_trips_hourly)), \"mmm yyyy\")",
            "lineageTag": "8a1b7572-c999-4b8a-9813-0e59581f3578"
          }
        ],
        "partitions": [
          {
            "name": "fct_trips_hourly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(SourceUrl, [RelativePath = \"fct_trips_hourly.csv\"]),",
                "        [Delimiter = \",\", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    EmptyAsNull = Table.TransformColumns(Headers, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"pickup_date\", type date}, {\"pickup_hour\", Int64.Type}, {\"segment\", type text}, {\"toll_period\", type text}, {\"trips\", Int64.Type}, {\"distance_mi\", type number}, {\"duration_min\", type number}, {\"fare_amount\", type number}, {\"tip_amount\", type number}, {\"total_amount\", type number}, {\"cbd_fee\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
